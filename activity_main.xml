<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f9fc"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER BRANDING & USER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAESTRO"
                android:textColor="#1e1b4b"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="easy does it"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:textStyle="medium" />
        </LinearLayout>

        <!-- Nama Pengguna -->
        <TextView
            android:id="@+id/displayUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anto"
            android:textColor="#6366f1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#e0e7ff"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <!-- SAPAAN & TANGGAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/greetingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat siang 👋"
            android:textColor="#1e1b4b"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rabu, 19 Agustus 2026"
            android:textColor="#64748b"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- PROGRESS CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#ffffff"
        android:padding="16dp"
        android:layout_marginBottom="20pr"
        android:elevation="2dp"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Progress hari ini"
                android:textColor="#1e1b4b"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/progressInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 dari 9 aktivitas selesai"
                android:textColor="#64748b"
                android:textSize="12sp"
                android:textStyle="semibold" />
        </LinearLayout>

        <!-- Dummy Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="65"
            android:progressTint="#6366f1"
            android:background="#f1f5f9" />
    </LinearLayout>

    <!-- TOMBOL UJI COBA ALARM -->
    <Button
        android:id="@+id/btnTestAlarm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🔔 Test Alarm 1 Menit Lagi"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#6366f1"
        android:elevation="2dp"
        android:layout_marginTop="10dp" />

</LinearLayout>

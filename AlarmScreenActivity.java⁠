package com.maestro.reminder;

import android.app.Activity;
import android.content.Context;
import android.os.Build;
import android.os.Bundle;
import android.os.Vibrator;
import android.view.View;
import android.view.Window;
import android.view.WindowManager;
import android.widget.Button;
import android.widget.TextView;

public class AlarmScreenActivity extends Activity {

    private Vibrator vibrator;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        // Mengatur agar layar menyala dan tampil di atas Lock Screen
        Window window = getWindow();
        window.addFlags(WindowManager.LayoutParams.FLAG_SHOW_WHEN_LOCKED |
                WindowManager.LayoutParams.FLAG_TURN_SCREEN_ON |
                WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);

        setContentView(R.layout.activity_alarm_screen);

        // Ambil data dari Intent
        String activityName = getIntent().getStringExtra("ACTIVITY_NAME");
        String userName = getIntent().getStringExtra("USER_NAME");

        if (activityName == null) activityName = "Olahraga";
        if (userName == null) userName = "Anto";

        // Hubungkan dengan komponen Tampilan XML
        TextView txtActivityName = findViewById(R.id.alarmActName);
        TextView txtMessage = findViewById(R.id.alarmMsg);
        Button btnStop = findViewById(R.id.btnStopAlarm);
        Button btnSnooze = findViewById(R.id.btnSnoozeAlarm);

        txtActivityName.setText("🏃 " + activityName.toUpperCase());
        txtMessage.setText(userName + ", saatnya " + activityName.toLowerCase() + ".");

        // Aktifkan getar
        vibrator = (Vibrator) getSystemService(Context.VIBRATOR_SERVICE);
        if (vibrator != null) {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                vibrator.vibrate(android.os.VibrationEffect.createWaveform(new long[]{0, 800, 400, 800}, 0));
            } else {
                vibrator.vibrate(new long[]{0, 800, 400, 800}, 0);
            }
        }

        // Tombol Matikan Alarm
        btnStop.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                stopAlarmAndClose();
            }
        });

        // Tombol Tunda / Snooze (5 menit)
        btnSnooze.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                // Logika snooze bisa ditambahkan di sini
                stopAlarmAndClose();
            }
        });
    }

    private void stopAlarmAndClose() {
        if (vibrator != null) {
            vibrator.cancel();
        }
        finish();
    }

    @Override
    public void onBackPressed() {
        // Mencegah tombol back menutup alarm sebelum dimatikan
        // Pengguna harus menekan tombol Matikan
    }
}

